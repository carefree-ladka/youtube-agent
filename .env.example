# =========================================================
# YouTube Agent - Environment Configuration
# Copy this file to `.env` and adjust values as needed.
# =========================================================

# ---------- App ----------
APP_NAME="YouTube Agent"
APP_ENV=development           # development | production
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
HOST=0.0.0.0
PORT=8000

# ---------- Output ----------
# Root folder where all generated projects are written.
OUTPUT_DIR=output

# ---------- Ollama (LLM + image concepts) ----------
# Ollama must be running locally: https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434
# Text model used for scripts + metadata (e.g. llama3.1, qwen2.5, mistral)
OLLAMA_TEXT_MODEL=llama3.1
# Image-generation model for thumbnail backgrounds (used when IMAGE_BACKEND=ollama).
# Example: x/flux2-klein:9b  (pull it first: `ollama pull x/flux2-klein:9b`)
OLLAMA_IMAGE_MODEL=x/flux2-klein:9b
# Request timeout (seconds) for model calls
OLLAMA_TIMEOUT=180
# Sampling temperature for creative generation
OLLAMA_TEMPERATURE=0.8

# ---------- Text To Speech ----------
# edge-tts gives free, smooth, natural neural voices (no API key required).
# Browse voices: `edge-tts --list-voices`
# Great smooth voices: en-US-JennyNeural, en-US-AriaNeural, en-US-GuyNeural,
#                      en-GB-SoniaNeural, en-US-AndrewMultilingualNeural
TTS_VOICE=en-US-JennyNeural
# Speaking rate & pitch adjustments (edge-tts format, e.g. +0%, -10%, +5Hz)
TTS_RATE=+0%
TTS_PITCH=+0Hz
TTS_VOLUME=+0%

# ---------- Branding (used on thumbnails) ----------
# Your channel name, shown as a small pill on thumbnails.
# Leave EMPTY to render thumbnails with no channel name.
CHANNEL_NAME=
BRAND_PRIMARY_COLOR=#FF0033
BRAND_SECONDARY_COLOR=#111827
BRAND_TEXT_COLOR=#FFFFFF

# ---------- Image generation (thumbnail backgrounds) ----------
# Backend for AI-generated thumbnail backgrounds:
#   none       -> use the built-in designed backgrounds (default, no extra deps)
#   ollama     -> generate backgrounds with an Ollama image model (OLLAMA_IMAGE_MODEL)
#   diffusers  -> generate locally with the diffusers library (needs requirements-image.txt)
#   comfyui    -> generate backgrounds via a running ComfyUI server (COMFYUI_* below)
# NOTE: the image model only paints the BACKGROUND (text-free). The crisp headline
# is always drawn by PIL on top - image models cannot spell reliably.
IMAGE_BACKEND=none
# Any diffusers-compatible text-to-image model on Hugging Face.
# Mac-friendly:  stabilityai/sdxl-turbo (recommended), stabilityai/sd-turbo (smaller)
# Higher quality/text: black-forest-labs/FLUX.1-schnell (large, slower on Mac)
DIFFUSERS_MODEL=stabilityai/sdxl-turbo
# Compute device: auto | mps | cuda | cpu   (auto picks mps on Apple Silicon)
DIFFUSERS_DEVICE=auto
# Turbo models: 1-4 steps, guidance 0.0. Non-turbo (e.g. FLUX): steps 20-28, guidance 3-7.
DIFFUSERS_STEPS=4
DIFFUSERS_GUIDANCE=0.0
# Native square generation size; the renderer crops it to each thumbnail format.
DIFFUSERS_SIZE=1024
# Darkness (0-255) of the overlay drawn over AI images so headline text stays readable.
THUMBNAIL_OVERLAY_OPACITY=110

# ---------- ComfyUI server (used when IMAGE_BACKEND=comfyui) ----------
COMFYUI_BASE_URL=http://localhost:8188
# Checkpoint file name exactly as it appears in ComfyUI/models/checkpoints/
COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors
COMFYUI_STEPS=25
COMFYUI_CFG=7.0
COMFYUI_SAMPLER=euler
COMFYUI_SCHEDULER=normal
COMFYUI_SIZE=1024
# Optional path to a custom API-format workflow JSON. Supports placeholders:
# %POSITIVE% %NEGATIVE% %WIDTH% %HEIGHT% %SEED% %CKPT% %STEPS% %CFG%
COMFYUI_WORKFLOW=
