# =========================================================
# YouTube Agent - Environment Configuration
# Copy this file to `.env` and adjust values as needed.
# =========================================================

# ---------- App ----------
APP_NAME="YouTube Agent"
APP_ENV=development           # development | production
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
HOST=0.0.0.0
PORT=8000

# ---------- Output ----------
# Root folder where all generated projects are written.
OUTPUT_DIR=output

# ---------- Ollama (LLM + image concepts) ----------
# Ollama must be running locally: https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434
# Text model used for scripts + metadata (e.g. llama3.1, qwen2.5, mistral)
OLLAMA_TEXT_MODEL=qwen3.8:27b
# Image-generation model for thumbnail backgrounds (used when IMAGE_BACKEND=ollama)
OLLAMA_IMAGE_MODEL=x/flux2-klein:9b
# Request timeout (seconds) for model calls
OLLAMA_TIMEOUT=180
# Sampling temperature for creative generation
OLLAMA_TEMPERATURE=0.8
# Reasoning models (e.g. qwen3) think in <think> blocks - slow + noisy.
# Keep false for fast, clean output; true only if you want chain-of-thought.
OLLAMA_THINK=false

# ---------- Text To Speech ----------
# Backend: "edge" (edge-tts, free online neural voices, word-synced subtitles)
#       or "f5" (F5-TTS, LOCAL zero-shot voice cloning - see F5 section below).
TTS_PROVIDER=edge
# edge-tts gives free, smooth, natural neural voices (no API key required).
# Browse voices: `edge-tts --list-voices`
# Great smooth voices: en-US-JennyNeural, en-US-AriaNeural, en-US-GuyNeural,
#                      en-GB-SoniaNeural, en-US-AndrewMultilingualNeural
TTS_VOICE=en-US-GuyNeural
# Speaking rate & pitch adjustments (edge-tts format, e.g. +0%, -10%, +5Hz)
TTS_RATE=+5%
TTS_PITCH=+0Hz
TTS_VOLUME=+0%

# ---------- F5-TTS: local voice cloning (only used when TTS_PROVIDER=f5) ----------
# Install deps first:  pip install -r requirements-voice.txt
# LICENSE: F5-TTS code is MIT but the pretrained WEIGHTS are CC-BY-NC
# (non-commercial). Review before using cloned audio commercially.
# Path to a short (~6-12s), CLEAN clip of the voice to clone (wav or mp3).
F5_REF_AUDIO=
# Transcript of that clip. Leave EMPTY to auto-transcribe it.
F5_REF_TEXT=
# Model preset (downloaded from Hugging Face on first use, several GB).
F5_MODEL=F5TTS_v1_Base
# Inference device: auto (cuda>mps>cpu) | mps | cuda | cpu
F5_DEVICE=auto
# Speaking speed (below 1.0 = slower, more human/deliberate). Shorts use SHORT.
F5_SPEED=0.9
F5_SPEED_SHORT=0.95
# Human pacing: pause between sentences + a longer breath at paragraph breaks
# (seconds). Set both to 0 for a continuous read.
F5_SENTENCE_PAUSE=0.33
F5_PARAGRAPH_PAUSE=0.6
# Loudness: F5 internal RMS target (higher = louder) + final peak-normalize of
# the WAV (peak 0..1; 0 disables) so cloned narration isn't quiet.
F5_TARGET_RMS=0.18
F5_PEAK=0.98
# Keep natural within-sentence silences (false = don't trim -> more human).
F5_REMOVE_SILENCE=false
# Fixed seed for a reproducible voice (-1 = random each run).
F5_SEED=-1

# ---------- Subtitle alignment (providers without native word timings) ----------
# F5-TTS has no word boundaries. If true AND faster-whisper is installed, word
# timings are recovered for accurate karaoke subtitles; otherwise subtitles are
# estimated across the real audio duration. (edge-tts ignores this.)
TTS_ALIGN=true
# faster-whisper size: tiny | base | small | medium | large-v3
ALIGN_MODEL=base
# Alignment device: auto (cpu on Mac - CTranslate2 has no MPS) | cpu | cuda
ALIGN_DEVICE=auto

# ---------- Web content enrichment (opt-in; make videos information-rich) -------
# When true, the agent researches the topic online and grounds the SCRIPT and the
# on-screen stat/quote/bullets in REAL facts (not vague filler). Combine with
# IMAGE_BACKEND=web to also pull real, license-aware photos for backgrounds.
# A credits.json listing every image source + license is written per run.
WEB_ENRICH=false
# Fact sources: wikipedia (no key) | duckduckgo (needs `pip install -r requirements-web.txt`) | both | none
WEB_SEARCH_BACKEND=wikipedia
# Max distilled facts fed into the script/storyboard.
WEB_MAX_FACTS=8
# Network timeout for enrichment calls (seconds).
WEB_TIMEOUT=20
# Polite User-Agent (Wikipedia/Openverse request one).
WEB_USER_AGENT=youtube-agent/0.1 (local content generator)
# Real-image source when IMAGE_BACKEND=web:
#   openverse (no key, CC/public-domain) | pexels (key) | pixabay (key) | wikimedia (no key)
WEB_IMAGE_SOURCE=openverse
# Openverse license filter - keep commercial+modification so results are safe to
# reuse (and ALWAYS verify attribution in credits.json before publishing).
WEB_IMAGE_LICENSE=commercial,modification
# Filter mature/NSFW results where supported.
WEB_SAFE=true
# Optional free-tier keys for higher-quality stock photo sources.
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ---------- Branding (used on thumbnails) ----------
# Your channel name for the thumbnail pill. Leave EMPTY to show no name.
CHANNEL_NAME=Code2Offer
BRAND_PRIMARY_COLOR=#FF0033
BRAND_SECONDARY_COLOR=#111827
BRAND_TEXT_COLOR=#FFFFFF

# ---------- Image generation (thumbnail backgrounds) ----------
# none      -> designed gradient/shape backgrounds (no model)
# ollama    -> generate backgrounds with an Ollama image model (OLLAMA_IMAGE_MODEL)
# diffusers -> generate backgrounds with a local diffusers model (DIFFUSERS_MODEL)
# comfyui   -> generate backgrounds via a running ComfyUI server (COMFYUI_* below)
# web       -> license-aware photo search (WEB_IMAGE_SOURCE)
# gemini    -> Google "Nano Banana" via the Gemini API (GEMINI_* below) - powers
#              BOTH thumbnails and video scene backgrounds
IMAGE_BACKEND=comfyui
DIFFUSERS_MODEL=stabilityai/sdxl-turbo
DIFFUSERS_DEVICE=auto
DIFFUSERS_STEPS=4
DIFFUSERS_GUIDANCE=0.0
DIFFUSERS_SIZE=1024
THUMBNAIL_OVERLAY_OPACITY=110

# Gemini image backend (used when IMAGE_BACKEND=gemini). Get an API key at
# https://aistudio.google.com/apikey. The Gemini API has its own free + paid
# tiers; a consumer Gemini app / Google AI Pro subscription does NOT grant API
# access - you still need an API key here.
GEMINI_API_KEY=
# gemini-3-pro-image (Nano Banana Pro, best) | gemini-3.1-flash-image (Nano
# Banana 2) | gemini-2.5-flash-image (legacy, cheapest)
GEMINI_IMAGE_MODEL=gemini-3-pro-image
GEMINI_IMAGE_SIZE=2K
GEMINI_IMAGE_TIMEOUT=120

# ComfyUI server (used when IMAGE_BACKEND=comfyui)
COMFYUI_BASE_URL=http://localhost:8188
# Checkpoint file name exactly as it appears in ComfyUI/models/checkpoints/
COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors
COMFYUI_STEPS=25
COMFYUI_CFG=7.0
COMFYUI_SAMPLER=euler
COMFYUI_SCHEDULER=normal
COMFYUI_SIZE=1024
# Optional: path to a custom exported API-format workflow JSON (placeholders supported)
COMFYUI_WORKFLOW=

# ---------- Video generation (Remotion) ----------
VIDEO_STYLE=modern-tech
VIDEO_RENDER_TIMEOUT=1800
VIDEO_MAX_CONCURRENT=1
# Transition/emphasis SFX volume (0..1) - low = subtle but noticeable.
VIDEO_SFX_VOLUME=0.2
# Background music bed: on by default (soft, slow generated ambient pad). Set
# VIDEO_MUSIC to a royalty-free track to use your own; keep the volume low.
VIDEO_MUSIC_ENABLED=true
VIDEO_MUSIC=
VIDEO_MUSIC_VOLUME=0.12
# ---------- Bring-your-own scene images (optional) ----------
# Folder of pre-made full-scene images (png/jpg/jpeg/webp/gif), e.g. designed in
# Gemini / Midjourney / Canva / Figma. When set, the agent SKIPS its own
# storyboard + asset generation and uses these as the video scenes - one
# full-bleed image per scene, in natural filename order (scene-1, scene-2, ...)
# or a manifest.json, retimed to the narration. Leave empty to generate scenes.
# Can also be overridden per request via the "scene_images_dir" field.
# Export at the target resolution (portrait 1080x1920 / landscape 1920x1080).
VIDEO_SCENES_DIR=
