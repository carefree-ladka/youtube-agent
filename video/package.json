{
  "name": "youtube-agent-video",
  "version": "0.1.0",
  "private": true,
  "description": "Generic, data-driven Remotion video engine for the YouTube Agent. Renders any storyboard JSON (portrait 1080x1920 or landscape 1920x1080) with no topic-specific code.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts ShortVideo out/video.mp4",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.534",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.534"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "typescript": "^5.9.3"
  }
}
